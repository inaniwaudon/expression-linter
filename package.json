{
  "name": "expression-linter",
  "displayName": "expression-linter",
  "description": "論文表現をチェックするリンタ",
  "version": "0.1.0",
  "publisher": "inaniwaudon",
  "repository": {
    "type": "git",
    "url": "https://github.com/inaniwaudon/expression-linter.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:tex",
    "onLanguage:latex",
    "onLanguage:markdown",
    "onLanguage:plaintext"
  ],
  "main": "./out/extension.js",
  "contributes": {},

  "scripts": {
    "vscode:prepublish": "yarn build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "publish": "vsce publish",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/kuromoji": "^0.1.3",
    "kuromoji": "^0.1.2"
  }
}
